{
  "manifest_version": 3,
  "name": "ProdHub Browser Tracker",
  "description": "Track browser activity and send heartbeats to your ProdHub dashboard",
  "version": "1.0.0",
  "permissions": ["tabs", "activeTab", "storage", "alarms"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
