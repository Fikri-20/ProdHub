generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  devices    Device[]
  categories Category[]
  apiKeys    ApiKey[]
  goals      Goal[]

  @@map("users")
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  name       String
  key        String    @unique              // SHA-256 hash of raw key
  prefix     String                         // first 8 chars for display (e.g. "pk_a1b2c3d4")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("api_keys")
}

model Device {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  os        String
  createdAt DateTime @default(now()) @map("created_at")

  user   User            @relation(fields: [userId], references: [id])
  events ActivityEvent[]

  @@unique([name, os, userId])
  @@map("devices")
}

model Category {
  id     String @id @default(uuid())
  userId String @map("user_id")
  name   String
  color  String @default("#6B7280")
  rules  String @default("[]") // JSON-serialized array of regex patterns

  user        User                 @relation(fields: [userId], references: [id])
  assignments CategoryAssignment[]

  @@unique([name, userId])
  @@map("categories")
}

model ActivityEvent {
  id          String   @id @default(uuid())
  deviceId    String   @map("device_id")
  appName     String   @map("app_name")
  windowTitle String   @map("window_title")
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  duration    Int      // seconds

  device      Device               @relation(fields: [deviceId], references: [id])
  categories  CategoryAssignment[]

  @@index([deviceId])
  @@index([startTime])
  @@index([appName])
  @@map("activity_events")
}

model Goal {
  id            String @id @default(uuid())
  userId        String @map("user_id")
  name          String
  targetSeconds Int    @map("target_seconds") // daily target in seconds
  appFilter     String? @map("app_filter")    // optional app name filter (null = all activity)
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([name, userId])
  @@map("goals")
}

model CategoryAssignment {
  id         String @id @default(uuid())
  eventId    String @map("event_id")
  categoryId String @map("category_id")

  event    ActivityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([eventId, categoryId])
  @@map("category_assignments")
}
