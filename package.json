{
  "name": "prodhub",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx --watch src/tracker.ts",
    "dev:server": "tsx --watch src/server.ts",
    "dev:web": "cd web && pnpm dev",
    "dev:desktop": "pnpm build:desktop && electron dist/desktop/main.cjs",
    "build": "tsup src/tracker.ts src/server.ts --format esm --outDir dist",
    "build:desktop": "tsup src/desktop/main.ts --format cjs --platform node --external electron --external get-windows --outDir dist/desktop",
    "prepare:desktop:installer": "pnpm build:desktop && node scripts/prepare-desktop-installer.mjs",
    "dist:desktop:dir": "pnpm prepare:desktop:installer && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --projectDir dist/desktop-installer --config ../../electron-builder.json --win dir",
    "dist:desktop:win": "pnpm prepare:desktop:installer && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --projectDir dist/desktop-installer --config ../../electron-builder.json --win nsis",
    "start": "node dist/tracker.js",
    "start:server": "node dist/server.js",
    "start:desktop": "electron dist/desktop/main.cjs",
    "start:bg": "node dist/tracker.js > tracker.log 2>&1 & disown",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "license": "ISC",
  "packageManager": "pnpm@10.30.1",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.0",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "prisma": "^7.4.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@paymoapp/active-window": "^2.1.2",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.3.1",
    "fastify": "^5.7.4",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "get-windows": "^9.2.3",
    "zod": "^4.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@paymoapp/active-window",
      "@prisma/engines",
      "better-sqlite3",
      "electron",
      "prisma"
    ],
    "ignoredBuiltDependencies": [
      "@paymoapp/active-window",
      "active-windows",
      "get-windows"
    ]
  }
}
