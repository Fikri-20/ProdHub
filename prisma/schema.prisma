generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")

  devices    Device[]
  categories Category[]

  @@map("users")
}

model Device {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  os        String
  createdAt DateTime @default(now()) @map("created_at")

  user   User            @relation(fields: [userId], references: [id])
  events ActivityEvent[]

  @@unique([name, os, userId])
  @@map("devices")
}

model Category {
  id     String   @id @default(uuid())
  userId String   @map("user_id")
  name   String
  color  String   @default("#6B7280")
  rules  String[] // regex patterns matching app name or window title

  user        User                 @relation(fields: [userId], references: [id])
  assignments CategoryAssignment[]

  @@unique([name, userId])
  @@map("categories")
}

model ActivityEvent {
  id          String   @id @default(uuid())
  deviceId    String   @map("device_id")
  appName     String   @map("app_name")
  windowTitle String   @map("window_title")
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  duration    Int      // seconds

  device      Device               @relation(fields: [deviceId], references: [id])
  categories  CategoryAssignment[]

  @@index([deviceId])
  @@index([startTime])
  @@index([appName])
  @@map("activity_events")
}

model CategoryAssignment {
  id         String @id @default(uuid())
  eventId    String @map("event_id")
  categoryId String @map("category_id")

  event    ActivityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([eventId, categoryId])
  @@map("category_assignments")
}
