generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Device {
  id        String   @id @default(uuid())
  name      String
  os        String
  createdAt DateTime @default(now()) @map("created_at")

  events ActivityEvent[]

  @@unique([name, os])
  @@map("devices")
}

model Category {
  id    String @id @default(uuid())
  name  String @unique
  color String @default("#6B7280")
  rules String[] // regex patterns matching app name or window title

  assignments CategoryAssignment[]

  @@map("categories")
}

model ActivityEvent {
  id          String   @id @default(uuid())
  deviceId    String   @map("device_id")
  appName     String   @map("app_name")
  windowTitle String   @map("window_title")
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  duration    Int      // seconds

  device      Device               @relation(fields: [deviceId], references: [id])
  categories  CategoryAssignment[]

  @@index([deviceId])
  @@index([startTime])
  @@index([appName])
  @@map("activity_events")
}

model CategoryAssignment {
  id         String @id @default(uuid())
  eventId    String @map("event_id")
  categoryId String @map("category_id")

  event    ActivityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([eventId, categoryId])
  @@map("category_assignments")
}
